{
  "manifest_version": 3,
  "name": "SIH 26171 Browser Agent",
  "description": "Privacy-preserving visual perception for lightweight browser agents",
  "version": "0.1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SIH 26171 Browser Agent"
  },
  "host_permissions": ["http://localhost:8000/*"]
}
